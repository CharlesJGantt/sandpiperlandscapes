{% extends "block.html.twig" %}
{#
/**
 * @file
 * Theme override for the site branding block.
 *
 * Overrides core to:
 *  - give the site logo a descriptive, location-aware alt value per the
 *    project SEO/accessibility rule, instead of the generic "Home" text
 *    hardcoded by core;
 *  - wrap the slogan in a block-level .site-slogan element so the tagline
 *    sits directly under the logo (and picks up the theme's .site-slogan
 *    styles) instead of flowing inline beside it.
 *
 * Available variables:
 * - site_logo: Logo for site as defined in Appearance or theme settings.
 * - site_name: Name for site as defined in Site information settings.
 * - site_slogan: Slogan for site as defined in Site information settings.
 *
 * @ingroup themeable
 */
#}
{% block content %}
  {% if site_logo %}
    <a href="{{ path('<front>') }}" rel="home">
      <img src="{{ site_logo }}" alt="Sandpiper Landscapes logo — lawn care and landscaping in Aiken, SC" fetchpriority="high" />
    </a>
  {% endif %}
  {% if site_name %}
    <a href="{{ path('<front>') }}" rel="home">{{ site_name }}</a>
  {% endif %}
  {% if site_slogan %}
    <div class="site-slogan">{{ site_slogan }}</div>
  {% endif %}
{% endblock %}
